# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Domains (create DNS "A" records pointing both at the server's IP first)
API_DOMAIN=api.yourdomain.in
ADMIN_DOMAIN=admin.yourdomain.in
ACME_EMAIL=you@yourdomain.in

# Secrets: generate each with `openssl rand -hex 32`
POSTGRES_PASSWORD=
JWT_SECRET=

# SMS login (MSG91, DLT-approved OTP template)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Test numbers for app-store reviewers: sign in with 123456, no SMS (comma separated)
REVIEWER_PHONES=+919999900001

# First owner login for the admin panel (used once by db:seed:production; 12+ characters)
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Optional
EXPO_ACCESS_TOKEN=
SENTRY_DSN=
VITE_SENTRY_DSN=
AUTO_ASSIGN=on
