# GlucoBuddy API (docker compose up). Android emulator: http://10.0.2.2:4000 · iOS simulator: http://localhost:4000
# Leave empty to run fully offline: sign-in, dietitian plans and family sharing are hidden.
EXPO_PUBLIC_API_URL=

# Crash reporting (Sentry). Leave empty to turn it off. Release app builds upload source maps when SENTRY_AUTH_TOKEN is set.
SENTRY_DSN=
VITE_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# New patients get the least-busy dietitian at the end of onboarding; "off" leaves them unassigned.
AUTO_ASSIGN=on

# Phone login. dev = no SMS: every number signs in with DEV_OTP_CODE (refused when NODE_ENV=production).
# msg91 = real SMS; DEV_TEST_PHONES (e.g. +9190000*) still use 123456 without SMS, for app-store reviewers.
OTP_MODE=dev
DEV_OTP_CODE=123456
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
