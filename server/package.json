{
  "name": "glucobuddy-server",
  "version": "1.0.0",
  "private": true,
  "description": "GlucoBuddy API: app sync, dietitian admin, notifications",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json",
    "start": "TS_NODE_BASEURL=./dist/server node -r tsconfig-paths/register dist/server/src/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "dump": "pg_dump --no-owner --no-acl \"$DATABASE_URL\" > prisma/dump.sql",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:seed:production": "tsx prisma/seed.ts --production"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "@sentry/node": "^9.47.2",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsconfig-paths": "4.2.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "nodemon": "3.1.10",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../packages/shared/src/$1",
      "^@/(.*)$": "<rootDir>/../src/$1"
    },
    "testTimeout": 30000
  }
}
