{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@shared/*": [
        "./packages/shared/src/*"
      ]
    },
    "types": [
      "jest"
    ]
  },
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "server",
    "admin",
    "packages/*/node_modules"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
